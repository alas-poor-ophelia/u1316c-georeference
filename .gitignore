node_modules/
main.js
*.map
*.log
.DS_Store

# Maintainer-facing planning notes stay local; they do not ship in the public repo.
SCOPE.md

# Scanner-gate scratch: the deliberate violations the phase-0 gate plants and removes. The gate
# clears up after itself, but an interrupted run must not be able to strand deliberate violations
# in the tracked tree — that is exactly what the store scan reads.
src/__gate/

# Throwaway measurement scripts. Guarded so an interrupted session cannot strand one in the
# tracked tree, which the store scan reads.
scripts/_scratch-*.ts

# Numerical-oracle scratch. The HARNESS is tracked (scripts/oracle/*.ts, *.py) because it is a
# gate; its generated case and output JSON are not, being large, regenerable and machine-specific.
scripts/oracle/*.json
scripts/oracle/__pycache__/

# The live gate's fixture vault: only the fixtures and the plugin list are tracked. Obsidian's own
# state files, the installed plugin copy (regenerated from the build) and screenshots are not.
test/live/geb-live/.obsidian/*
!test/live/geb-live/.obsidian/community-plugins.json
test/live/geb-live/.trash/
test/live/screenshots/
